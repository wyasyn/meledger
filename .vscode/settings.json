{
  // apps/mobile/android/ is generated by Expo prebuild. Importing it in the Java, Gradle and
  // Kotlin extensions starts extra Gradle and Kotlin daemons (6+ GB of RAM), which runs the
  // machine out of memory when the emulator or an APK build runs on top of them.
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.autobuild.enabled": false,
  "java.server.launchMode": "LightWeight",
  "gradle.autoDetect": "off",
  "kotlin.languageServer.enabled": false,
  "kotlin.debugAdapter.enabled": false,
  "files.watcherExclude": {
    "**/android/build/**": true,
    "**/android/app/build/**": true,
    "**/android/.gradle/**": true
  }
}
